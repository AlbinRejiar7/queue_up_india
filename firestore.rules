rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function hasBlocked(blockerUid, targetUid) {
      return exists(/databases/$(database)/documents/users/$(blockerUid)/private/blocks) &&
        get(/databases/$(database)/documents/users/$(blockerUid)/private/blocks).data.blockedUserIds != null &&
        targetUid in get(/databases/$(database)/documents/users/$(blockerUid)/private/blocks).data.blockedUserIds;
    }

    function areUsersBlocked(firstUid, secondUid) {
      return hasBlocked(firstUid, secondUid) || hasBlocked(secondUid, firstUid);
    }

    function directChatHasNoBlocksAfter(chatId) {
      return !areUsersBlocked(
        getAfter(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants[0],
        getAfter(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants[1]
      );
    }

    function isPartyHost(partyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/parties/$(partyId)).data.hostId
          == request.auth.uid;
    }

    function isPartyMember(partyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isOwner(uid);

      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /rooms/{partyId} {
        allow read, write: if isOwner(uid);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow get, list: if isOwner(uid) ||
          (
            isSignedIn() &&
            resource.data.type == 'chat_request' &&
            resource.data.status == 'pending' &&
            resource.data.fromUserId == request.auth.uid
          );
        allow create: if isSignedIn() &&
          !areUsersBlocked(request.auth.uid, uid) &&
          request.resource.data.fromUserId == request.auth.uid &&
          (
            (request.resource.data.type == 'chat_request' &&
              request.resource.data.status == 'pending') ||
            (request.resource.data.type == 'chat_request_response' &&
              (request.resource.data.status == 'accepted' ||
                request.resource.data.status == 'declined'))
          );
        allow update, delete: if isOwner(uid);
      }
    }

    match /availability/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /match_pool/{bucketId}/metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /match_pool/{bucketId}/tickets/{ticketId} {
      allow read, write: if false;
    }

    match /solo_squads/{squadId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.playerIds;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /bug_reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /parties/{partyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.partyCode is string &&
        request.resource.data.partyCode.size() > 0;
      allow update, delete: if isPartyHost(partyId);

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          (memberId == request.auth.uid || isPartyHost(partyId));
        allow update, delete: if isPartyHost(partyId) ||
          memberId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if isPartyMember(partyId);
        allow create: if isPartyMember(partyId);
        allow update, delete: if false;
      }
    }

    match /direct_chats/{chatId} {
      allow get: if isSignedIn() &&
        (
          resource == null ||
          request.auth.uid in resource.data.participants
        );
      allow list: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        !areUsersBlocked(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants &&
          directChatHasNoBlocksAfter(chatId);
        allow update, delete: if false;
      }
    }

    match /games/{gameId} {
      allow read: if true;
    }

    match /games/{gameId}/ranks/{rankId} {
      allow read: if true;
    }

    match /languages/{languageId} {
      allow read: if true;
    }
  }
}
